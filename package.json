{
  "name": "temporal-fmt-codemod",
  "version": "0.1.0",
  "description": "jscodeshift codemod that rewrites dayjs and date-fns call sites to temporal-fmt equivalents. AST-based, not regex — safe to run unsupervised on a real production codebase.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "temporal-fmt-codemod": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --declaration --emitDeclarationOnly",
    "test": "node --test test/*.test.js",
    "codemod": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "jscodeshift",
    "codemod",
    "dayjs",
    "date-fns",
    "temporal-fmt",
    "migration"
  ],
  "license": "MIT",
  "dependencies": {
    "jscodeshift": "^17.4.0"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^26.2.0",
    "jscodeshift": "^17.4.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
